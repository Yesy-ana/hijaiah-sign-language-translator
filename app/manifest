            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:exported="true" />

        <activity
            android:name=".TranslateActivity"
            android:exported="true" />

        <activity
            android:name=".VideoActivity"
            android:exported="true" />

        <activity
            android:name=".QuizActivity"
            android:exported="true" />

        <activity
            android:name=".QuizResultActivity"
            android:exported="true" />

        <activity android:name=".MatchActivity"
